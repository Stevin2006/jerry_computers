# ------------------------------------------------------------------
# JERRY COMPUTERS — frontend environment variables
# Copy this file to `.env` and adjust as needed.
# ------------------------------------------------------------------

# Base URL of the Django REST API (no trailing slash needed).
# Example development value:
VITE_API_URL=http://localhost:8000/api

# When "true" the app runs against the built-in mock backend so the
# whole experience (auth, OTP, products, orders, services, support,
# admin) works without Django. Set to "false" to hit the real API.
VITE_USE_MOCK=true

# Optional demo hint shown on the OTP screen in mock mode only.
VITE_SHOW_MOCK_OTP=true
